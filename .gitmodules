[submodule "tmux/.tmux"]
	path = tmux
	url = https://github.com/gpakosz/.tmux.git
    shallow = true
[submodule "redpill/omz"]
	path = ohmyzsh
	url = https://github.com/ohmyzsh/ohmyzsh.git
    shallow = true
[submodule "bluepill/plugins/fast-syntax-highlighting"]
	path = bluepill/plugins/fast-syntax-highlighting
	url = https://github.com/zdharma-continuum/fast-syntax-highlighting.git
    shallow = true
[submodule "bluepill/plugins/git-prompt"]
	path = bluepill/plugins/git-prompt
	url = https://github.com/woefe/git-prompt.zsh.git
    shallow = true
[submodule "bluepill/plugins/zsh-syntax-highlighting"]
	path = bluepill/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
    shallow = true
[submodule "bluepill/themes/spaceship-prompt"]
	path = bluepill/themes/spaceship-prompt
	url = https://github.com/spaceship-prompt/spaceship-prompt.git
    shallow = true
    ignore = dirty
[submodule "bluepill/plugins/zsh-vi-mode"]
	path = bluepill/plugins/zsh-vi-mode
	url = https://github.com/jeffreytse/zsh-vi-mode
    shallow = true
[submodule "bluepill/plugins/zsh-autosuggestions"]
	path = bluepill/plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions.git
    shallow = true
[submodule "bluepill/plugins/fzf-tab"]
	path = bluepill/plugins/fzf-tab
	url = https://github.com/Aloxaf/fzf-tab
    shallow = true
[submodule "bluepill/plugins/zsh-nvm"]
	path = bluepill/plugins/zsh-nvm
	url = https://github.com/lukechilds/zsh-nvm.git
    shallow = true
[submodule "alacritty/themes"]
	path = alacritty/themes
	url = https://github.com/alacritty/alacritty-theme
    shallow = true
[submodule "bluepill/plugins/nix-zsh-completions"]
	path = bluepill/plugins/nix-zsh-completions
	url = https://github.com/nix-community/nix-zsh-completions.git
    shallow = true
[submodule "kitty/themes/catppuccin"]
	path = kitty/themes/catppuccin
	url = https://github.com/catppuccin/kitty.git
    shallow = true
[submodule "kitty/themes/kitty-themes"]
	path = kitty/themes/kitty-themes
	url = https://github.com/kovidgoyal/kitty-themes.git
    shallow = true
