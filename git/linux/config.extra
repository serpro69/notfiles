[alias]
  clone-tmp = "!_f() { _dir="$(mktemp -u)"; git clone "$1" "$_dir"; echo "$_dir" | xclip -r -selection clipboard; unset -f _f; }; _f"
  prune-delete = "!f() { origin="$1"; if [ -z "$origin" ]; then origin='origin'; fi; git remote prune "$origin" | grep pruned | sed -E 's/.*origin\\/(.*)/\\1/' | xargs -I {} git branch -D '{}' 2> /dev/null; }; f"
  wt = "!f() { if [ -z \"$1\" ]; then printf '\\033[31merror: missing branch name\\033[0m\nusage: git wt <branch>\n'; exit 1; fi; local dir=\"$(mktemp -u)\"; local br=$(echo \"$2\" | xargs); if [ -z \"${br}\" ]; then br='master'; fi; git worktree add -b \"$1\" \"$dir\" \"$br\"; echo \"$dir\" | xargs | xclip -selection clipboard; }; f"
  capy = "!f() { if [ -z \"$1\" ]; then printf 'usage: git capy <command> [<args>]\nexamples:\n  git capy status\n  git capy commit -m \"...\"\n'; exit 0; fi; git -C ~/Projects/personal/capy-knowledge-db \"$@\"; }; f"
