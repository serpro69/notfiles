#!/bin/sh
#
# vim: set ft=sh:
#
# File: .shellrc
# Description:
#   Contains base shell configuration and runs the terminal multiplexer

# need to enable homebrew here in case we have tmux installed via brew
if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# other shell integrations
if command -v navi > /dev/null; then
  eval "$(navi widget zsh)"
fi

# Runs the terminal multiplexer based on the configuration settings and SSH connection

if [ -n "$SSH_TTY" ]; then
  _TERM=$CONFIG_TERM_SSH
else
  _TERM=$CONFIG_TERM_LOCAL
fi

echo "$TERMCAP" | grep -Eq '.*screen.*'
if [ "$_TERM" = 'screen' ] && [ $? -eq 1 ]; then
  screen -xR remote
  exit
fi

if [ "$_TERM" = 'byobu' ] && [ -z "$BYOBU_BACKEND" ]; then
  byobu
  exit
fi

if [ "$_TERM" = 'tmux' ] && [ -z "$TMUX" ]; then
  # get the id of a deattached session
  TMUX_ID="$(tmux ls 2> /dev/null | grep -v -m 1 attached | cut -d: -f 1)"

  if [ -z "$TMUX_ID" ]; then
    # if not available create a new one
    if ! tmux has-session 2> /dev/null \
      && [ -d "$CONFIG_CAPY_KB_DIR" ] && [ -d "$CONFIG_CAPY_DATA_DIR" ]; then
      # first session on the server only: its first window is the capy split
      # (kb left, data dir right), focused on the left pane;
      # a regular shell window goes after it
      # TODO: the has-session check means killing session 0 while other sessions
      #   still run leaves no capy window until the server restarts. To recreate it
      #   "whenever no session has the capy window" instead: name the window
      #   (`new-session -n capy`) and replace `! tmux has-session` with
      #   `! tmux list-windows -a -F '#{window_name}' 2> /dev/null | grep -qx capy`.
      #   Downside: a session's auto-renamed window could also end up named "capy".
      _capy_win="$(tmux new-session -d -P -F '#{window_id}' -c "$CONFIG_CAPY_KB_DIR")"
      tmux split-window -h -t "$_capy_win" -c "$CONFIG_CAPY_DATA_DIR"
      tmux select-pane -L -t "$_capy_win"
      tmux new-window -d -a -t "$_capy_win" -c "$PWD"
      tmux attach-session -t "$_capy_win"
      unset _capy_win
    else
      tmux new-session
    fi
  else
    # if available attach to it
    tmux attach-session -t "$TMUX_ID"
  fi
fi

if $(which cmatrix > /dev/null); then cmatrix; fi
