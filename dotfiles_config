#!/usr/bin/env bash

CONFIG_DEFAULT_USER="sergio"
CONFIG_CHARSET_UTF8=true
CONFIG_LANG="en_US"
#CONFIG_ZSH_PLUGINS="(zsh-vi-mode zsh-autosuggestions git git-extras gh gcloud kubectl gitignore z dircycle web-search sudo extract history-substring-search npm yarn github docker-compose sublime colorize colored-man-pages copybuffer dotenv grc fnm rust fast-syntax-highlighting git-prompt terraform)"
CONFIG_ZSH_PLUGINS="(zsh-nvm colored-man-pages colorize copybuffer dircycle docker docker-compose dotenv extract fast-syntax-highlighting fnm gcloud gh git git-extras github gitignore git-prompt grc history-substring-search kubectl npm rust sublime sudo opentofu web-search yarn z zsh-autosuggestions zsh-vi-mode spaceship-tfb-section spaceship-plb-section spaceship-opentofu-section fzf-tab ssh-agent nix-zsh-completions mise)"
CONFIG_ZSH_THEME="spaceship"
CONFIG_TERM_LOCAL="tmux" # terminal multiplexer: screen byobu tmux
CONFIG_TERM_SSH=""
# dirs for the capy window that shellrc opens first in the first tmux session
# (left pane: knowledge-db repo, right pane: capy data dir)
if [ "$(uname)" = "Darwin" ]; then
  CONFIG_CAPY_KB_DIR="$HOME/Projects/personal/capy-knowledge-db"
  CONFIG_CAPY_DATA_DIR="$HOME/.local/share/capy"
else
  # TODO: unconfirmed linux locations; adjust to the actual paths
  CONFIG_CAPY_KB_DIR="$HOME/Projects/personal/capy-knowledge-db"
  CONFIG_CAPY_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/capy"
fi
CONFIG_LOGGING="ERROR" # Options: OFF, ERROR, WARN, INFO, TRACE
